# ==========================================
# VolunteerNet Backend - Environment Variables
# ==========================================

# Server Port (Render automatically sets this, fallback for local dev is 5000)
PORT=5000

# Node Environment ("development" or "production")
NODE_ENV=production

# MongoDB Atlas Connection URI
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://username:password@cluster0.example.mongodb.net/volunteernet?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=replace_with_a_secure_random_string_min_32_characters
JWT_EXPIRES_IN=7d

# Allowed Frontend Origins for CORS & Socket.IO (without trailing slashes)
# Deployed Vercel URLs
CLIENT_STUDENT_URL=https://volunteernet-student.vercel.app
CLIENT_ADMIN_URL=https://volunteernet-admin.vercel.app

# Optional: Additional comma-separated allowed origins (e.g. custom domains, preview URLs)
ALLOWED_ORIGINS=https://volunteernet-student.vercel.app,https://volunteernet-admin.vercel.app

# Admin Account Seeding (Used when running: npm run seed:admin)
ADMIN_EMAIL=admin@volunteernet.com
ADMIN_PASSWORD=replace_with_a_strong_production_password

