# ==========================================
# VolunteerNet Admin Client - Environment Variables
# ==========================================

# Backend API URL (must include /api, no trailing slash)
# For production on Render: https://your-backend.onrender.com/api
# For local development: http://localhost:5000/api
VITE_API_URL=https://your-backend.onrender.com/api

# Backend Socket.IO Server URL (base URL without /api, no trailing slash)
# For production on Render: https://your-backend.onrender.com
# For local development: http://localhost:5000
VITE_SOCKET_URL=https://your-backend.onrender.com
